## Visual Studio & .NET .gitignore

# Build results
[Bb]in/
[Oo]bj/
[Pp]ublish/
[Ll]og/
[Ll]ogs/

# Visual Studio files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Rider & JetBrains
.idea/
*.sln.iml

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# User generated profiles & backups (keep templates/defaults, ignore local test outputs)
profiles/temp/
*.log
