<Window x:Class="WorkspaceSwitcher.UI.Views.WorkspaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create Workspace" 
        Icon="pack://application:,,,/app.ico"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgDeepNightBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Margin="16" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Inputs -->
                <RowDefinition Height="Auto"/>
                <!-- Buttons -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock x:Name="HeaderIconText" Text="📷" FontSize="18" Foreground="{StaticResource AccentIndigoBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="HeaderTitleText" Text="Create Workspace" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="HeaderSubtitleText" Text="Capture your current multi-monitor window layout into a saved profile." FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>

            <!-- Form Inputs -->
            <StackPanel Grid.Row="1">
                <!-- Workspace Name -->
                <TextBlock Text="Workspace Name" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="NameTextBox" Style="{StaticResource DarkGlassTextBox}" Margin="0,0,0,14"/>

                <!-- Description -->
                <TextBlock Text="Description (optional)" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="DescriptionTextBox" Style="{StaticResource DarkGlassTextBox}" Margin="0,0,0,16"/>

                <!-- Icon Picker -->
                <TextBlock Text="Workspace Icon" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                <ListBox x:Name="IconListBox" 
                         Background="Transparent" BorderThickness="0" Margin="0,0,0,16"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" Width="430"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,10,10"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="IconBorder" Background="#161D36" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Width="42" Height="42" Cursor="Hand">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="IconBorder" Property="BorderBrush" Value="{StaticResource AccentIndigoBrush}"/>
                                                <Setter TargetName="IconBorder" Property="Background" Value="#222B4E"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="IconBorder" Property="Background" Value="{StaticResource AccentIndigoBrush}"/>
                                                <Setter TargetName="IconBorder" Property="BorderBrush" Value="White"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Hotkey Customization -->
                <TextBlock Text="Quick Switch Hotkey" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="ModifierComboBox" Grid.Column="0" Style="{StaticResource DarkGlassComboBox}"/>
                    <ComboBox x:Name="KeyComboBox" Grid.Column="2" Style="{StaticResource DarkGlassComboBox}"/>
                </Grid>
            </StackPanel>

            <!-- Bottom Buttons -->
            <Grid Grid.Row="2" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="PrimaryActionButton" Grid.Column="0" 
                        Style="{StaticResource IndigoGradientButton}" 
                        Content="📸 Capture &amp; Save" 
                        Padding="16,10"
                        Click="PrimaryActionButton_Click"/>

                <Button Grid.Column="2" 
                        Style="{StaticResource DarkSecondaryButton}" 
                        Content="Cancel" 
                        Padding="16,10"
                        Click="CancelButton_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
