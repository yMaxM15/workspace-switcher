<Window x:Class="WorkspaceSwitcher.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WorkspaceSwitcher.UI.ViewModels"
        mc:Ignorable="d"
        Title="Workspace Switcher" 
        Icon="app.ico"
        Height="780" Width="1180"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepNightBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Grid Margin="18,12,18,16">
        <Grid.RowDefinitions>
            <!-- Top Header Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER BAR -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <!-- Left: App Branding -->
                <ColumnDefinition Width="*"/>
                <!-- Right: Running Status Badge & Window Controls -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand Logo + Title -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="10" Background="#11162A" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                    <Image Source="app.ico" Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Workspace Switcher" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Save, restore and switch your Windows layouts." FontSize="11.5" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Running Pill Status -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#0D1224" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14,6" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#10B981" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Running" FontSize="11.5" FontWeight="SemiBold" Foreground="#10B981" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Ctrl + Alt + 1–5" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 2. MAIN 2-COLUMN CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Column (Create + Workspaces List) -->
                <ColumnDefinition Width="340"/>
                <!-- Right Column (Inspector & Settings) -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN (Full-Height Workspaces List + New Modal) -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <!-- My Workspaces List Card (Full Height) -->
                    <RowDefinition Height="*"/>
                    <!-- Bottom Notice Card -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- CARD 1: My Workspaces List -->
                <Border Grid.Row="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16,16" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Header with count & + New Button -->
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="My Workspaces" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Border Background="#1E2642" CornerRadius="8" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalProfilesCount}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                            </StackPanel>

                            <Button Style="{StaticResource IndigoGradientButton}" 
                                    Content="+ New" 
                                    HorizontalAlignment="Right" 
                                    Padding="14,6" FontSize="11.5" FontWeight="Bold"
                                    Command="{Binding OpenCreateWorkspaceDialogCommand}"/>
                        </Grid>

                        <!-- Workspaces List -->
                        <ListBox Grid.Row="1" 
                                 ItemsSource="{Binding Profiles}" 
                                 SelectedItem="{Binding SelectedProfile}"
                                 Background="Transparent" 
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder" 
                                                        Background="{StaticResource CardBgLightBrush}" 
                                                        BorderBrush="{StaticResource CardBorderBrush}" 
                                                        BorderThickness="1" 
                                                        CornerRadius="10" 
                                                        Padding="12,10">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource CardBorderHoverBrush}"/>
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#1A2342"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentIndigoBrush}"/>
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#1E284E"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left Icon Badge -->
                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8" Background="{Binding IconBrush}" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IconGlyph}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Center: Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,1,0,2" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding RelativeTime}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>

                                        <!-- Right: Metadata & Actions -->
                                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding WindowCount, StringFormat='{}{0} windows'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding MonitorCount, StringFormat='{}🖥 {0}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                                            </StackPanel>

                                            <!-- Mini Action Buttons (Apply, Edit Modal, Delete) -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Style="{StaticResource DarkIconButton}" 
                                                        Content="▶" 
                                                        Padding="6,3" FontSize="10" Margin="0,0,4,0"
                                                        ToolTip="Apply layout"
                                                        Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource DarkIconButton}" 
                                                        Content="✏️" 
                                                        Padding="5,3" FontSize="10" Margin="0,0,4,0"
                                                        ToolTip="Edit workspace"
                                                        Command="{Binding DataContext.OpenEditWorkspaceDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Style="{StaticResource DarkIconButton}" 
                                                        Content="🗑️" 
                                                        Padding="5,3" FontSize="10"
                                                        ToolTip="Delete workspace"
                                                        Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- CARD 2: Bottom Notice Card -->
                <Border Grid.Row="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🖥" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Workspace Switcher is running in the background" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Use your global hotkeys to quickly switch between workspaces." FontSize="10" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT COLUMN (Hero Header + Windows List + Settings) -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- Hero Header Card -->
                    <RowDefinition Height="Auto"/>
                    <!-- Windows in this Workspace Card -->
                    <RowDefinition Height="*"/>
                    <!-- Restore Settings Card -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. HERO HEADER CARD -->
                <Border Grid.Row="0" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20,16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Large Icon + Name + Description + Tags -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Border Width="42" Height="42" CornerRadius="10" Background="{StaticResource IndigoPurpleGradient}" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedProfile.IconGlyph, FallbackValue='💻'}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedProfile.Name, FallbackValue='Select a Workspace'}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding SelectedProfile.Description, FallbackValue='Choose a workspace from the left panel'}" FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Metadata tags row -->
                            <StackPanel Orientation="Horizontal" Margin="56,0,0,0">
                                <TextBlock Text="{Binding SelectedProfile.WindowCount, StringFormat='{}🗔 {0} Windows  •  '}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SelectedProfile.MonitorCount, StringFormat='{}🖥 {0} Monitors  •  '}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding SelectedProfile.RelativeTime, StringFormat='{}Captured: {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: Action Buttons (Restore Workspace + Update) -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Button Style="{StaticResource IndigoGradientButton}" 
                                    Padding="20,10" Margin="0,0,0,8"
                                    Command="{Binding ApplyProfileCommand}"
                                    CommandParameter="{Binding SelectedProfile}"
                                    IsEnabled="{Binding HasSelectedProfile}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="▶" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Restore Workspace" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource DarkSecondaryButton}" 
                                        Padding="12,6" Margin="0,0,6,0"
                                        Command="{Binding OverwriteProfileCommand}"
                                        CommandParameter="{Binding SelectedProfile}"
                                        IsEnabled="{Binding HasSelectedProfile}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔄" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Update Workspace" FontSize="11.5" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource DarkIconButton}" 
                                        Content="🗑️" 
                                        Padding="10,6" FontSize="11"
                                        Command="{Binding DeleteProfileCommand}"
                                        CommandParameter="{Binding SelectedProfile}"
                                        IsEnabled="{Binding HasSelectedProfile}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. WINDOWS IN THIS WORKSPACE LIST -->
                <Border Grid.Row="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18,14" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Title + View Pill -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Windows in this workspace" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Border Background="#1E2642" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedProfile.WindowCount, FallbackValue='0'}" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Windows List -->
                        <ListBox Grid.Row="1" 
                                 ItemsSource="{Binding SelectedProfile.WindowItems}" 
                                 Background="Transparent" 
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,7"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="WindowRowBorder" 
                                                        Background="{StaticResource CardBgLightBrush}" 
                                                        BorderBrush="{StaticResource CardBorderBrush}" 
                                                        BorderThickness="1" 
                                                        CornerRadius="10" 
                                                        Padding="12,9">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="WindowRowBorder" Property="BorderBrush" Value="{StaticResource CardBorderHoverBrush}"/>
                                                        <Setter TargetName="WindowRowBorder" Property="Background" Value="#1A2342"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <!-- Main Row Header (Click to expand/customize) -->
                                        <Button Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand"
                                                Command="{Binding ToggleExpandCommand}"
                                                HorizontalContentAlignment="Stretch">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <!-- Process Icon + Name + Exe Path -->
                                                    <ColumnDefinition Width="220"/>
                                                    <!-- Window Title -->
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- State Pill Badge -->
                                                    <ColumnDefinition Width="90"/>
                                                    <!-- Monitor & Coordinates -->
                                                    <ColumnDefinition Width="150"/>
                                                    <!-- Arrow -->
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Process Column -->
                                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- App Icon -->
                                                    <Image Grid.Column="0" Source="{Binding AppIcon}" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ProcessName}" FontWeight="Bold" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding ExecutablePath}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Window Title -->
                                                <TextBlock Grid.Column="1" Text="{Binding WindowTitle}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,14,0" TextTrimming="CharacterEllipsis"/>

                                                <!-- State Pill Badge -->
                                                <Border Grid.Column="2" CornerRadius="6" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource NormalStateBg}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StateText}" Value="Maximized">
                                                                    <Setter Property="Background" Value="{StaticResource MaximizedStateBg}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding StateText}" Value="Minimized">
                                                                    <Setter Property="Background" Value="{StaticResource MinimizedStateBg}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <TextBlock Text="{Binding StateText}" FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource NormalStateText}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding StateText}" Value="Maximized">
                                                                        <Setter Property="Foreground" Value="{StaticResource MaximizedStateText}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding StateText}" Value="Minimized">
                                                                        <Setter Property="Foreground" Value="{StaticResource MinimizedStateText}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>

                                                <!-- Monitor & Coordinates -->
                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding MonitorDisplay}" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding FormattedCoordinates}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                                </StackPanel>

                                                <!-- Expand Chevron Button -->
                                                <TextBlock Grid.Column="4" Text="{Binding ChevronIcon}" FontSize="13" Foreground="{StaticResource AccentIndigoBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                            </Grid>
                                        </Button>

                                        <!-- Expandable Customization Drawer -->
                                        <Border Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" 
                                                Background="#0E1326" 
                                                BorderBrush="#1E2746" 
                                                BorderThickness="0,1,0,0" 
                                                Margin="-12,9,-12,-9" 
                                                Padding="14,12" 
                                                CornerRadius="0,0,10,10">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <!-- Row 1: State & Monitor Selectors -->
                                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- State Selector -->
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Target Window State:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <ComboBox Style="{StaticResource DarkGlassComboBox}"
                                                                  ItemsSource="{Binding AvailableStates}" 
                                                                  SelectedItem="{Binding State, Mode=TwoWay}"/>
                                                    </StackPanel>

                                                    <!-- Monitor Selector -->
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Target Display / Monitor:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                        <ComboBox Style="{StaticResource DarkGlassComboBox}"
                                                                  ItemsSource="{Binding AvailableMonitors}" 
                                                                  SelectedItem="{Binding SelectedMonitor, Mode=TwoWay}"
                                                                  DisplayMemberPath="Name"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Row 2: Custom Coordinates (X, Y, Width, Height) -->
                                                <Grid Grid.Row="1" Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Left (X)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                        <TextBox Style="{StaticResource DarkGlassTextBox}" Text="{Binding Left, UpdateSourceTrigger=LostFocus}" Padding="6,4" FontSize="11"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Top (Y)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                        <TextBox Style="{StaticResource DarkGlassTextBox}" Text="{Binding Top, UpdateSourceTrigger=LostFocus}" Padding="6,4" FontSize="11"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="4">
                                                        <TextBlock Text="Width (px)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                        <TextBox Style="{StaticResource DarkGlassTextBox}" Text="{Binding Width, UpdateSourceTrigger=LostFocus}" Padding="6,4" FontSize="11"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="6">
                                                        <TextBlock Text="Height (px)" FontSize="10" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,2"/>
                                                        <TextBox Style="{StaticResource DarkGlassTextBox}" Text="{Binding Height, UpdateSourceTrigger=LostFocus}" Padding="6,4" FontSize="11"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- Row 3: Actions & Auto-Save hint -->
                                                <Grid Grid.Row="2">
                                                    <TextBlock Text="⚡ Changes auto-save directly to your workspace profile" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                    
                                                    <Button Style="{StaticResource DarkSecondaryButton}" 
                                                            Content="🗑️ Remove from Workspace" 
                                                            HorizontalAlignment="Right"
                                                            Foreground="#F87171"
                                                            BorderBrush="#7F1D1D"
                                                            Padding="10,4" FontSize="10.5"
                                                            Command="{Binding RemoveWindowCommand}"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- 3. RESTORE SETTINGS CARD (with iOS / Fluent Purple Toggle Switches) -->
                <Border Grid.Row="2" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18,14">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="⚙" FontSize="13" Foreground="{StaticResource AccentIndigoBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Restore Settings" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Left Option -->
                                <ColumnDefinition Width="*"/>
                                <!-- Divider -->
                                <ColumnDefinition Width="24"/>
                                <!-- Right Option -->
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Option 1: Auto-launch closed apps -->
                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Auto-launch closed apps on restore" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Automatically start applications that were closed." FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ModernToggleSwitch}" IsChecked="{Binding AutoLaunchMissingApps}"/>
                            </Grid>

                            <!-- Option 2: Minimize to System Tray -->
                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="Minimize to System Tray on close [X]" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="Keep Workspace Switcher running in the background." FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox Grid.Column="1" Style="{StaticResource ModernToggleSwitch}" IsChecked="{Binding MinimizeToTrayOnClose}"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
