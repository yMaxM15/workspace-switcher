<Window x:Class="WorkspaceSwitcher.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WorkspaceSwitcher.UI.ViewModels"
        mc:Ignorable="d"
        Title="Workspace Switcher" 
        Height="680" Width="1020"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI, Segoe UI Variable">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header / Titlebar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Area -->
            <RowDefinition Height="*"/>
            <!-- Status Bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="🪟" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="Workspace Switcher" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Multi-Window Layout Manager &amp; Hotkey Dispatcher" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Hotkey Status Badge -->
                <Border Grid.Column="2" Background="#1B3322" BorderBrush="{StaticResource SuccessGreenBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessGreenBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Global Hotkeys Active (Ctrl+Alt+1..5)" FontSize="11" FontWeight="SemiBold" Foreground="#4EC9B0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Row="1" Margin="20,16">
            <Grid.ColumnDefinitions>
                <!-- Left: Snapshot + Profiles list -->
                <ColumnDefinition Width="380"/>
                <!-- Right: Profile Inspector & Details -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Snapshot & Profiles -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <!-- Snapshot Form Card -->
                    <RowDefinition Height="Auto"/>
                    <!-- Profile List Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Profile List -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Capture Snapshot Card -->
                <Border Grid.Row="0" Background="{StaticResource CardDarkBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="📸 Take Layout Snapshot" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBox Style="{StaticResource DarkTextBox}" 
                                 Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" 
                                 Tag="Profile name (e.g. Coding, Gaming)" 
                                 Margin="0,0,0,8"/>
                        <TextBox Style="{StaticResource DarkTextBox}" 
                                 Text="{Binding NewProfileDescription, UpdateSourceTrigger=PropertyChanged}" 
                                 Tag="Optional description" 
                                 Margin="0,0,0,12"/>
                        <Button Style="{StaticResource PrimaryButton}" 
                                Content="Capture Current Windows" 
                                Command="{Binding CaptureNewProfileCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Profiles List Header -->
                <Grid Grid.Row="1" Margin="0,4,0,8">
                    <TextBlock Text="Saved Workspaces" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="🔄 Refresh" HorizontalAlignment="Right" Padding="8,3" FontSize="11" Command="{Binding RefreshProfilesCommand}"/>
                </Grid>

                <!-- Profiles List -->
                <ListBox Grid.Row="2" 
                         ItemsSource="{Binding Profiles}" 
                         SelectedItem="{Binding SelectedProfile}"
                         Background="Transparent" 
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" 
                                                Background="{StaticResource CardDarkBrush}" 
                                                BorderBrush="{StaticResource CardBorderBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="8" 
                                                Padding="12">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentCyanBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#2A2D30"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top Row: Name & Window Count Badge -->
                                <Grid Grid.Row="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <Border Background="#333333" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding WindowCount, StringFormat='{}{0} Windows'}" FontSize="10" Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>

                                <!-- Middle: Description -->
                                <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,8" TextTrimming="CharacterEllipsis"/>

                                <!-- Bottom: Action Buttons -->
                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource PrimaryButton}" 
                                            Content="⚡ Apply" 
                                            Padding="10,4" FontSize="11" Margin="0,0,6,0"
                                            Command="{Binding DataContext.ApplyProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource SecondaryButton}" 
                                            Content="📸 Overwrite" 
                                            Padding="8,4" FontSize="11" Margin="0,0,6,0"
                                            Command="{Binding DataContext.OverwriteProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource DangerButton}" 
                                            Content="🗑️" 
                                            Padding="8,4" FontSize="11"
                                            Command="{Binding DataContext.DeleteProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- RIGHT COLUMN: Profile Inspector & Details -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- Detail Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Windows List in Profile -->
                    <RowDefinition Height="*"/>
                    <!-- Preferences / Settings Box -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Detail Header -->
                <Border Grid.Row="0" Background="{StaticResource CardDarkBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding SelectedProfile.Name, FallbackValue='Select a Profile'}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding SelectedProfile.Description, FallbackValue='Click on a profile on the left to view captured windows'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Button Grid.Column="1" 
                                Style="{StaticResource PrimaryButton}" 
                                Content="⚡ Apply This Workspace" 
                                Padding="16,8"
                                Command="{Binding ApplyProfileCommand}"
                                CommandParameter="{Binding SelectedProfile}"
                                IsEnabled="{Binding HasSelectedProfile}"/>
                    </Grid>
                </Border>

                <!-- Captured Windows List -->
                <Border Grid.Row="1" Background="{StaticResource CardDarkBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Captured Windows in Profile:" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,8"/>

                        <ListView Grid.Row="1" 
                                  ItemsSource="{Binding SelectedProfileWindows}" 
                                  Background="Transparent" 
                                  BorderThickness="0" 
                                  Foreground="{StaticResource TextPrimaryBrush}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Process" Width="120">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ProcessName}" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Window Title" Width="240">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding WindowTitle}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="State" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#2B2B2B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Placement.State}" FontSize="11" Foreground="#9CDCFE"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>

                                    <GridViewColumn Header="Coordinates (X, Y, W, H)" Width="170">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0}, {1} ({2}x{3})">
                                                            <Binding Path="Placement.NormalPosition.Left"/>
                                                            <Binding Path="Placement.NormalPosition.Top"/>
                                                            <Binding Path="Placement.NormalPosition.Width"/>
                                                            <Binding Path="Placement.NormalPosition.Height"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </Border>

                <!-- Settings / Options Footer -->
                <Border Grid.Row="2" Background="{StaticResource CardDarkBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" 
                                  IsChecked="{Binding AutoLaunchMissingApps}" 
                                  Foreground="{StaticResource TextPrimaryBrush}" 
                                  VerticalAlignment="Center">
                            <TextBlock Text="Auto-launch closed apps on restore" FontSize="12"/>
                        </CheckBox>

                        <CheckBox Grid.Column="1" 
                                  IsChecked="{Binding MinimizeToTrayOnClose}" 
                                  Foreground="{StaticResource TextPrimaryBrush}" 
                                  VerticalAlignment="Center">
                            <TextBlock Text="Minimize to System Tray on close [X]" FontSize="12"/>
                        </CheckBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="20,8">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</Window>
